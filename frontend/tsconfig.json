{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/lib/**/*.ts",
    "src/components/**/*.tsx",
    "src/vite-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/App Files",
    "src/App Files/**/*",
    "src/components/App.tsx",
    "src/components/App_WITH_INLINE_MEDICATION_EXECUTIVE_SUMMARY.tsx",
    "src/App_RELEASE_CANDIDATE_TABBED_HORIZONTAL_LAYOUT_FIXED.tsx"
  ]
}